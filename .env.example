# Rename this file to .env and fill in your API keys.
# Never commit .env to git.

# Anthropic Claude API (for Stage 1 topic naming and optional Stage 2 voice)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API (for Stage 2 ensemble third voice)
GEMINI_API_KEY=AIza...

# HuggingFace token (optional; needed if any model is behind a gate)
HF_TOKEN=hf_...
